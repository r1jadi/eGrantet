NEXT_PUBLIC_SITE_URL=https://egrantet.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI provider (GroqCloud OpenAI-compatible API).
# Never expose these to the client; see README for details.
# Get a free key at https://console.groq.com/keys and paste it into
# AI_API_KEY in .env.local (local) and the Vercel project dashboard (prod).
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# Optional per-feature model overrides (each falls back to AI_MODEL).
# OPENAI_DOCUMENT_ANALYSIS_MODEL=
# OPENAI_APPLICATION_SUMMARY_MODEL=
# OPENAI_DECISION_LETTER_MODEL=
# OPENAI_VERIFICATION_SYNTHESIS_MODEL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Comma-separated platform admin emails (server only). Leave empty to use the
# database role/membership model only; when set, only these emails get
# platform-admin access. Never put real addresses here.
ADMIN_EMAILS=

# Dedicated, non-production Supabase test account. Integration tests are opt-in.
RUN_SUPABASE_INTEGRATION_TESTS=false
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
SUPABASE_TEST_MUNICIPALITY_ID=
SUPABASE_TEST_OTHER_MUNICIPALITY_ID=
SUPABASE_TEST_OTHER_APPLICANT_APPLICATION_ID=
